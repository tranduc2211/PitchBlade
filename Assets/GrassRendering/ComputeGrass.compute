// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
float3 rootPos;
float fieldLengthHalf;
float3 cameraPos;
float3 cameraForward;
float3 cameraForwardLeft30;
float3 cameraForwardRight30;
float halfFov;
float distanceBetween2Grass;


RWStructuredBuffer<float4> colorBuffer;
RWTexture2D<float4> grassRenderTexture;
RWStructuredBuffer<float> colorLerpBuffer;

int groupSizeColoring;
 
int numberOfGrassPerRowDividedByCameraResolution;
[numthreads(16, 16, 1)]
void CSColoring(uint3 id : SV_DispatchThreadID)
{
    int grassIndex = id.y * 16 * groupSizeColoring + id.x;
     
    
    float4 color = grassRenderTexture[id.yx / numberOfGrassPerRowDividedByCameraResolution];
    
    //PC
    //Meta Quest
    float brightnessValue =1;
    float brightnessValue2 = lerp(3, 1, colorLerpBuffer[grassIndex]);
    
    float4 colorRoot = color * brightnessValue;
    float4 colorTop = color * brightnessValue2;
    
    colorRoot = clamp(colorRoot, 0.0f, 1.0f);
    colorTop = clamp(colorTop, 0.0f, 1.0f);
    
    
     //check if black
    float totalRGBcolor = color.r + color.g + color.b;
    totalRGBcolor = clamp(totalRGBcolor, 0, 1);
    
    colorRoot.a = totalRGBcolor;
    colorTop.a = totalRGBcolor;
    
    colorBuffer[3 * grassIndex] = colorRoot;
    colorBuffer[3 * grassIndex + 1] = colorRoot;
    colorBuffer[3 * grassIndex + 2] = colorTop;
    
   
    

}
int numberOfGrassBladePerRow;
RWStructuredBuffer<int> cullingBuffer;
int groupSize;
[numthreads(16,16,1)] 
void CSCulling(uint3 id : SV_DispatchThreadID)
{
     
    // TODO: insert actual code here!
    int grassIndex = id.y * 16 * groupSize  + id.x ;
    float3 bladePos = (0,0,0); 
    bladePos.x = id.y * distanceBetween2Grass + rootPos.x - fieldLengthHalf;
    bladePos.z = id.x * distanceBetween2Grass + rootPos.z - fieldLengthHalf;
    
    float3 viewDir = bladePos - cameraPos;
    int visible = step(0 ,cameraForward.x * viewDir.x + cameraForward.y * viewDir.y + cameraForward.z * viewDir.z );
    int visible2 = step(0, cameraForwardLeft30.x * viewDir.x + cameraForwardLeft30.y * viewDir.y + cameraForwardLeft30.z * viewDir.z);
   int visible3 = step(0, cameraForwardRight30.x * viewDir.x + cameraForwardRight30.y * viewDir.y + cameraForwardRight30.z * viewDir.z);
   
    
    
    visible = visible * visible2 * visible3;
    cullingBuffer[3 * grassIndex] = visible;
    cullingBuffer[3 * grassIndex + 1] = visible;
   cullingBuffer[3 * grassIndex + 2] = visible;
}


